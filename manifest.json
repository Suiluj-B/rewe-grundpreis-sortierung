{
  "manifest_version": 3,
  "name": "REWE Grundpreis-Sortierung",
  "version": "1.2.1",
  "description": "Sortiert den REWE Onlineshop nach Grundpreis (€/kg, €/l), merkt sich Preise über alle Seiten und zeigt Preisverlauf und Trends.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.rewe.de/*"
      ],
      "js": [
        "src/unitprice.js",
        "src/store.js",
        "src/panel.js",
        "src/chart.js",
        "src/settings.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{a60236bb-58d7-4f5d-a518-118f060ff2aa}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
